{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blinko-sweepstakes",
  "main": "server/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "blinkosweepstakes.oopsiwon.com", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BLINKO_CORE",
        "class_name": "BlinkoCore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BlinkoCore"]
    }
  ]
}
